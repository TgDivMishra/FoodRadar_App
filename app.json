{
  "expo": {
    "name": "FoodRadar",
    "slug": "FoodFinderApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/FoodRadar_Logo.png",
    "scheme": "foodfinderapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/FoodRadar_Logo.png"
    },
    "android": {
      "package": "com.divyansh.foodradar",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/FoodRadar_Logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/FoodRadar_Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/FoodRadar_Logo.png",
          "imageWidth": 280
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FoodRadar to access your location to discover food spots around you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b15bbbdd-b997-4755-b8b7-9285e7273749"
      }
    }
  }
}
